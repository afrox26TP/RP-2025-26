# Godot import/cache artifacts (generated automatically)
.import/
*.import
# Keep the CSV import settings versioned: they must stay "keep" (no import),
# otherwise Godot imports the CSVs as translations and the raw files are missing from exports.
!map_data/*.csv.import
.godot/

# Godot generated texture/cache formats
*.ctex
*.md5
*.s3tc.ctex

# Export/build outputs
opengs_export/
export/
build/
*.exe
*.pck
*.console

# Editor/user-local files
.vscode/
*.tmp
*.temp
*.log

# OS junk
Thumbs.db
Desktop.ini
.DS_Store
